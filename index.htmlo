    <!-- ========== SCRIPTS ========== -->
    
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- 🔥 Cargar configuración de Supabase ANTES de los módulos -->
    <script src="/js/komerzio-config.js"></script>

    <script type="module">
        import { supabase } from '/js/supabase-client.js'
        import { initCarrito } from '/js/cart.js'
        import { auth } from '/js/auth.js'
        import { notificaciones } from '/js/notificaciones.js'
        
        console.log('✅ Supabase iniciado correctamente');
        
        async function cargarNotificacionesMasivas() {
            if (!auth.isAuthenticated()) return [];
            const usuario = auth.getUsuario();
            const { data: masivas, error } = await supabase
                .from('notificaciones_masivas')
                .select('*')
                .eq('activo', true)
                .or(`fecha_expiracion.is.null,fecha_expiracion.gt.${new Date().toISOString()}`)
                .order('created_at', { ascending: false });
            if (error || !masivas || masivas.length === 0) return [];
            const { data: leidas } = await supabase
                .from('notificaciones_masivas_leidas')
                .select('notificacion_id')
                .eq('user_id', usuario.id);
            const leidasIds = new Set(leidas?.map(l => l.notificacion_id) || []);
            return masivas.map(n => ({
                id: n.id, user_id: usuario.id, titulo: n.titulo, mensaje: n.mensaje,
                tipo: n.tipo || 'masiva', leida: leidasIds.has(n.id),
                created_at: n.created_at, link_url: n.link_url, data: n.data || {}, es_masiva: true
            }));
        }
        
        window.notificaciones = notificaciones;
        const carrito = initCarrito()
        window.carrito = carrito; window.cart = carrito
        carrito.cargarDeLocalStorage(); carrito.actualizarInterfaz()
        window.vaciarCarrito = () => carrito.vaciar();

        async function cargarSaldoHeader() {
            const saldoCard = document.getElementById('saldoHeaderCard');
            const saldoAmount = document.getElementById('saldoHeaderAmount');
            const usuario = auth.getUsuario();
            if (!usuario) { saldoCard.style.display = 'none'; return; }
            try {
                const { data, error } = await supabase.from('saldo_usuarios').select('saldo_actual').eq('user_id', usuario.id).single();
                if (error && error.code !== 'PGRST116') throw error;
                saldoAmount.textContent = `$${(data?.saldo_actual || 0).toFixed(2)}`;
                saldoCard.style.display = 'flex';
            } catch (error) { console.error('Error cargando saldo:', error); }
        }

        function actualizarBotonLogin() {
            const loginBtn = document.getElementById('loginBtnHeader');
            if (!loginBtn) return;
            const usuario = auth.getUsuario();
            if (usuario) {
                const inicial = usuario.nombre?.charAt(0).toUpperCase() || usuario.email?.charAt(0).toUpperCase() || 'U';
                loginBtn.innerHTML = `<i class="fa fa-user"></i><span>${inicial}</span>`;
                loginBtn.href = '/mi-cuenta.html'; cargarSaldoHeader();
            } else {
                loginBtn.innerHTML = '<i class="fa fa-sign-in"></i><span>Iniciar sesión</span>';
                loginBtn.href = '/login.html';
                document.getElementById('saldoHeaderCard').style.display = 'none';
            }
        }

        let panelVisible = false;
        
        async function actualizarBadgeCampana() {
            const individualesNoLeidas = notificaciones.contarNoLeidas();
            const masivas = await cargarNotificacionesMasivas();
            const masivasNoLeidas = masivas.filter(n => !n.leida).length;
            const totalNoLeidas = individualesNoLeidas + masivasNoLeidas;
            const badge = document.getElementById('campana-badge');
            if (badge) {
                if (totalNoLeidas > 0) { badge.textContent = totalNoLeidas; badge.style.display = 'flex'; }
                else { badge.style.display = 'none'; }
            }
        }
        
        async function renderizarListaNotificaciones() {
            const container = document.getElementById('campana-lista');
            if (!container) return;
            const individuales = notificaciones.notificaciones || [];
            const masivas = await cargarNotificacionesMasivas();
            const todas = [...individuales, ...masivas];
            todas.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
            const listaMostrar = todas.slice(0, 10);
            if (listaMostrar.length === 0) { container.innerHTML = '<div class="campana-vacio">No hay notificaciones</div>'; return; }
            container.innerHTML = listaMostrar.map(n => {
                const fecha = new Date(n.created_at).toLocaleString();
                const noLeida = !n.leida ? 'no-leida' : '';
                const esMasiva = n.es_masiva ? true : false;
                return `<div class="campana-item ${noLeida}" onclick="window.abrirNotificacionHeader(${n.id}, ${esMasiva})"><div class="campana-item-titulo">${n.titulo}</div><div class="campana-item-mensaje">${n.mensaje}</div><div class="campana-item-fecha">${fecha}</div>${esMasiva ? '<div style="font-size: 10px; color: #f97316; margin-top: 4px;">📢 Notificación masiva</div>' : ''}</div>`;
            }).join('');
        }
        
        window.togglePanelNotificaciones = function() {
            const panel = document.getElementById('campana-panel');
            if (!panel) return;
            panelVisible = !panelVisible;
            panel.style.display = panelVisible ? 'block' : 'none';
            if (panelVisible) renderizarListaNotificaciones();
        };
        
        window.marcarTodasLeidasHeader = async function() {
            await notificaciones.marcarTodasComoLeidas();
            const masivas = await cargarNotificacionesMasivas();
            const usuario = auth.getUsuario();
            if (usuario && masivas.length > 0) {
                for (const n of masivas) {
                    if (!n.leida) {
                        await supabase.from('notificaciones_masivas_leidas').insert({ notificacion_id: n.id, user_id: usuario.id, leida_at: new Date().toISOString() }).onConflict('notificacion_id,user_id').ignore();
                    }
                }
            }
            await renderizarListaNotificaciones(); await actualizarBadgeCampana();
        };
        
        window.abrirNotificacionHeader = async function(id, esMasiva = false) {
            const usuario = auth.getUsuario();
            if (esMasiva && usuario) {
                await supabase.from('notificaciones_masivas_leidas').insert({ notificacion_id: id, user_id: usuario.id, leida_at: new Date().toISOString() }).onConflict('notificacion_id,user_id').ignore();
            } else if (!esMasiva) {
                await notificaciones.marcarComoLeida(id);
            }
            await renderizarListaNotificaciones(); await actualizarBadgeCampana();
            window.location.href = '/notificaciones.html';
        };
        
        document.addEventListener('click', function(e) {
            const campana = document.getElementById('campana-notificaciones');
            if (panelVisible && campana && !campana.contains(e.target)) {
                const panel = document.getElementById('campana-panel');
                if (panel) { panel.style.display = 'none'; panelVisible = false; }
            }
        });
        
        notificaciones.onNuevaNotificacion(async () => { await renderizarListaNotificaciones(); await actualizarBadgeCampana(); });
        notificaciones.onNotificacionesCargadas(async () => { await renderizarListaNotificaciones(); await actualizarBadgeCampana(); });

        async function cargarSlider() {
            try {
                const { data, error } = await supabase.from('productos').select('id, nombre, imagen_url, categoria').eq('destacado', true).limit(5);
                if (error) throw error;
                if (data && data.length > 0) { renderizarSlider(data); }
                else {
                    const { data: ultimos } = await supabase.from('productos').select('id, nombre, imagen_url, categoria').order('created_at', { ascending: false }).limit(5);
                    renderizarSlider(ultimos || []);
                }
            } catch (error) { console.error('Error cargando slider:', error); }
        }

        function renderizarSlider(productos) {
            const container = document.getElementById('home-slider');
            if (!container || productos.length === 0) return;
            container.innerHTML = productos.map(p => `
                <div class="slider-item">
                    <a href="/producto.html?id=${p.id}">
                        <img src="${p.imagen_url || '/assets/images/no-image.jpg'}" alt="${p.nombre}" onerror="this.src='/assets/images/no-image.jpg'">
                    </a>
                    <div class="post-info-wrap">
                        <span class="post-tag">${p.categoria || 'Destacado'}</span>
                        <h2 class="post-title"><a href="/producto.html?id=${p.id}">${p.nombre}</a></h2>
                    </div>
                </div>
            `).join('');
            initSlider();
        }

        function initSlider() {
            if (typeof $ !== 'undefined' && $.fn.owlCarousel) {
                const $slider = $('#home-slider');
                if ($slider.data('owl.carousel')) { $slider.trigger('destroy.owl.carousel'); $slider.find('.owl-stage-outer').children().unwrap(); }
                $slider.owlCarousel({ items: 1, loop: true, autoplay: true, autoplayTimeout: 4000, autoplayHoverPause: true, dots: true, nav: false, smartSpeed: 800, animateOut: 'fadeOut', animateIn: 'fadeIn' });
            }
        }

        let listaDeseosUsuario = [];
        
        async function cargarListaDeseos() {
            const usuario = auth.getUsuario();
            if (!usuario) { listaDeseosUsuario = []; return; }
            const { data, error } = await supabase.from('lista_deseos').select('producto_id').eq('usuario_id', usuario.id);
            if (!error) { listaDeseosUsuario = data.map(item => item.producto_id); }
        }
        
        window.toggleWishlist = async function(productoId) {
            const usuario = auth.getUsuario();
            if (!usuario) {
                Swal.fire({ icon: 'info', title: 'Inicia sesión', text: 'Debes iniciar sesión para guardar productos en tu lista de deseos', showCancelButton: true, confirmButtonText: 'Iniciar sesión', cancelButtonText: 'Cancelar' }).then(result => { if (result.isConfirmed) window.location.href = '/login.html'; });
                return;
            }
            const existe = listaDeseosUsuario.includes(productoId);
            if (existe) {
                const { error } = await supabase.from('lista_deseos').delete().eq('usuario_id', usuario.id).eq('producto_id', productoId);
                if (!error) { listaDeseosUsuario = listaDeseosUsuario.filter(id => id !== productoId); actualizarCorazon(productoId, false); Swal.fire({ icon: 'success', title: 'Eliminado', text: 'Producto eliminado de tu lista de deseos', timer: 1500, showConfirmButton: false }); }
            } else {
                const { error } = await supabase.from('lista_deseos').insert([{ usuario_id: usuario.id, producto_id: productoId }]);
                if (!error) { listaDeseosUsuario.push(productoId); actualizarCorazon(productoId, true); Swal.fire({ icon: 'success', title: '¡Guardado!', text: 'Producto agregado a tu lista de deseos', timer: 1500, showConfirmButton: false }); }
            }
        };

        function actualizarCorazon(productoId, activo) {
            const botones = document.querySelectorAll(`.wishlist-btn[onclick*="toggleWishlist('${productoId}')"]`);
            botones.forEach(btn => {
                if (activo) { btn.classList.add('active'); btn.querySelector('i').className = 'fa fa-heart'; }
                else { btn.classList.remove('active'); btn.querySelector('i').className = 'fa fa-heart-o'; }
            });
        }

        function renderizarPrecioConDescuento(producto) {
            const tieneOferta = producto.oferta_del_dia === true && producto.precio_oferta && parseFloat(producto.precio_oferta) > 0 && parseFloat(producto.precio_oferta) < parseFloat(producto.precio);
            const precioActual = tieneOferta ? producto.precio_oferta : producto.precio;
            const precioOriginal = producto.precio;
            const descuento = tieneOferta ? Math.round(((precioOriginal - precioActual) / precioOriginal) * 100) : 0;
            if (tieneOferta) {
                return `<div class="product-price">$${parseFloat(precioActual).toFixed(2)} <small>USD</small><span class="product-original-price">$${parseFloat(precioOriginal).toFixed(2)}</span><span class="product-discount">-${descuento}%</span></div>`;
            } else {
                return `<div class="product-price">$${parseFloat(precioActual).toFixed(2)} <small>USD</small></div>`;
            }
        }

        async function cargarDestacados() {
            const { data, error } = await supabase.from('productos').select('*').eq('destacado', true).limit(9)
            if (error) return
            const container = document.getElementById('featured-products')
            if (!container) return
            container.innerHTML = data.map(producto => {
                const enLista = listaDeseosUsuario.includes(producto.id);
                if (producto.stock <= 0) {
                    return `<div class="product-card"><div class="wishlist-btn ${enLista ? 'active' : ''}" onclick="toggleWishlist('${producto.id}')"><i class="fa ${enLista ? 'fa-heart' : 'fa-heart-o'}"></i></div><a href="/producto.html?id=${producto.id}"><img src="${producto.imagen_url || '/assets/images/no-image.jpg'}" class="product-image" alt="${producto.nombre}"><h3 class="product-title">${producto.nombre}</h3></a>${renderizarPrecioConDescuento(producto)}<div class="product-agotado"><i class="fa fa-ban"></i> AGOTADO</div></div>`
                } else {
                    return `<div class="product-card"><div class="wishlist-btn ${enLista ? 'active' : ''}" onclick="toggleWishlist('${producto.id}')"><i class="fa ${enLista ? 'fa-heart' : 'fa-heart-o'}"></i></div><a href="/producto.html?id=${producto.id}"><img src="${producto.imagen_url || '/assets/images/no-image.jpg'}" class="product-image" alt="${producto.nombre}"><h3 class="product-title">${producto.nombre}</h3></a>${renderizarPrecioConDescuento(producto)}<div class="product-stock stock-available"><i class="fa fa-check-circle"></i> ${producto.stock} disponibles</div><button class="btn-add-cart" onclick="window.carrito.agregar('${producto.id}', 1)"><i class="fa fa-shopping-cart"></i> Agregar</button></div>`
                }
            }).join('')
        }

        async function cargarOfertas() {
            const { data, error } = await supabase.from('productos').select('*').eq('oferta_del_dia', true).limit(4)
            if (error) return
            const container = document.getElementById('hot-posts-container')
            if (!container) return
            container.innerHTML = data.map(producto => {
                const enLista = listaDeseosUsuario.includes(producto.id);
                return `<div class="product-card"><div class="wishlist-btn ${enLista ? 'active' : ''}" onclick="toggleWishlist('${producto.id}')"><i class="fa ${enLista ? 'fa-heart' : 'fa-heart-o'}"></i></div><a href="/producto.html?id=${producto.id}"><img src="${producto.imagen_url || '/assets/images/no-image.jpg'}" class="product-image" alt="${producto.nombre}"><h3 class="product-title">${producto.nombre}</h3></a>${renderizarPrecioConDescuento(producto)}<button class="btn-add-cart" onclick="window.carrito.agregar('${producto.id}', 1)"><i class="fa fa-shopping-cart"></i> Comprar</button></div>`
            }).join('')
        }

        let autoplayIntervals = {};

        // ===== FUNCIONES CORREGIDAS - USAN SECCIONES =====
        async function cargarConsumibles() {
            try {
                const { data, error } = await supabase
                    .from('productos')
                    .select('*')
                    .contains('secciones', ['consumibles'])
                    .limit(10);
                if (error) throw error;
                renderizarCarrusel(data || [], 'consumiblesCarrusel', 'consumiblesProgress');
                initCarruselAutoplay('consumiblesCarrusel', 'consumiblesPrev', 'consumiblesNext', 'consumiblesProgress');
            } catch (error) { console.error('Error cargando consumibles:', error); }
        }

        async function cargarLimpieza() {
            try {
                const { data, error } = await supabase
                    .from('productos')
                    .select('*')
                    .contains('secciones', ['limpieza'])
                    .limit(10);
                if (error) throw error;
                renderizarCarrusel(data || [], 'limpiezaCarrusel', 'limpiezaProgress');
                initCarruselAutoplay('limpiezaCarrusel', 'limpiezaPrev', 'limpiezaNext', 'limpiezaProgress');
            } catch (error) { console.error('Error cargando limpieza:', error); }
        }

        function renderizarCarrusel(productos, contenedorId, progressId) {
            const container = document.getElementById(contenedorId);
            const progress = document.getElementById(progressId);
            if (!container) return;
            if (!productos || productos.length === 0) {
                container.innerHTML = '<p style="text-align: center; padding: 40px; color: #718096;">No hay productos disponibles</p>';
                if (progress) progress.innerHTML = '';
                return;
            }
            container.innerHTML = productos.map(producto => {
                const enLista = listaDeseosUsuario.includes(producto.id);
                if (producto.stock <= 0) {
                    return `<div class="carrusel-item"><div class="wishlist-btn ${enLista ? 'active' : ''}" onclick="toggleWishlist('${producto.id}')"><i class="fa ${enLista ? 'fa-heart' : 'fa-heart-o'}"></i></div><a href="/producto.html?id=${producto.id}"><img src="${producto.imagen_url || '/assets/images/no-image.jpg'}" class="product-image" alt="${producto.nombre}"><h3 class="product-title">${producto.nombre}</h3></a>${renderizarPrecioConDescuento(producto)}<div class="product-agotado"><i class="fa fa-ban"></i> AGOTADO</div></div>`;
                } else {
                    return `<div class="carrusel-item"><div class="wishlist-btn ${enLista ? 'active' : ''}" onclick="toggleWishlist('${producto.id}')"><i class="fa ${enLista ? 'fa-heart' : 'fa-heart-o'}"></i></div><a href="/producto.html?id=${producto.id}"><img src="${producto.imagen_url || '/assets/images/no-image.jpg'}" class="product-image" alt="${producto.nombre}"><h3 class="product-title">${producto.nombre}</h3></a>${renderizarPrecioConDescuento(producto)}<button class="btn-add-cart-small" onclick="window.carrito.agregar('${producto.id}', 1)"><i class="fa fa-shopping-cart"></i> Agregar</button></div>`;
                }
            }).join('');
            if (progress && productos.length > 0) {
                progress.innerHTML = productos.map((_, index) => `<div class="carrusel-progress-dot" data-index="${index}"></div>`).join('');
            }
        }

        function initCarruselAutoplay(contenedorId, prevId, nextId, progressId, intervalo = 5000) {
            const container = document.getElementById(contenedorId);
            const prevBtn = document.getElementById(prevId);
            const nextBtn = document.getElementById(nextId);
            const progress = document.getElementById(progressId);
            if (!container) return;
            const scrollAmount = 280;
            function updateProgress() {
                if (!progress) return;
                const scrollPosition = container.scrollLeft;
                const activeIndex = Math.round(scrollPosition / scrollAmount);
                progress.querySelectorAll('.carrusel-progress-dot').forEach((dot, index) => { dot.classList.toggle('active', index === activeIndex); });
            }
            function nextSlide() {
                const maxScroll = container.scrollWidth - container.clientWidth;
                let newScrollLeft = container.scrollLeft + scrollAmount;
                if (newScrollLeft > maxScroll) newScrollLeft = 0;
                container.scrollTo({ left: newScrollLeft, behavior: 'smooth' });
                setTimeout(updateProgress, 300);
            }
            function prevSlide() {
                const maxScroll = container.scrollWidth - container.clientWidth;
                let newScrollLeft = container.scrollLeft - scrollAmount;
                if (newScrollLeft < 0) newScrollLeft = maxScroll;
                container.scrollTo({ left: newScrollLeft, behavior: 'smooth' });
                setTimeout(updateProgress, 300);
            }
            if (prevBtn) prevBtn.addEventListener('click', prevSlide);
            if (nextBtn) nextBtn.addEventListener('click', nextSlide);
            if (progress) {
                progress.addEventListener('click', (e) => {
                    const dot = e.target.closest('.carrusel-progress-dot');
                    if (dot && dot.dataset.index !== undefined) {
                        container.scrollTo({ left: parseInt(dot.dataset.index) * scrollAmount, behavior: 'smooth' });
                        setTimeout(updateProgress, 300);
                    }
                });
            }
            container.addEventListener('scroll', updateProgress);
            if (autoplayIntervals[contenedorId]) clearInterval(autoplayIntervals[contenedorId]);
            autoplayIntervals[contenedorId] = setInterval(nextSlide, intervalo);
            container.addEventListener('mouseenter', () => { if (autoplayIntervals[contenedorId]) clearInterval(autoplayIntervals[contenedorId]); });
            container.addEventListener('mouseleave', () => { if (autoplayIntervals[contenedorId]) clearInterval(autoplayIntervals[contenedorId]); autoplayIntervals[contenedorId] = setInterval(nextSlide, intervalo); });
            setTimeout(updateProgress, 100);
        }

        async function cargarUltimos() {
            const { data, error } = await supabase.from('productos').select('*').order('created_at', { ascending: false }).limit(8)
            if (error) return
            const container = document.getElementById('latest-products')
            if (!container) return
            container.innerHTML = data.map(producto => {
                const enLista = listaDeseosUsuario.includes(producto.id);
                if (producto.stock <= 0) {
                    return `<div class="product-card"><div class="wishlist-btn ${enLista ? 'active' : ''}" onclick="toggleWishlist('${producto.id}')"><i class="fa ${enLista ? 'fa-heart' : 'fa-heart-o'}"></i></div><a href="/producto.html?id=${producto.id}"><img src="${producto.imagen_url || '/assets/images/no-image.jpg'}" class="product-image" alt="${producto.nombre}"><h3 class="product-title">${producto.nombre}</h3></a>${renderizarPrecioConDescuento(producto)}<div class="product-agotado"><i class="fa fa-ban"></i> AGOTADO</div></div>`
                } else {
                    return `<div class="product-card"><div class="wishlist-btn ${enLista ? 'active' : ''}" onclick="toggleWishlist('${producto.id}')"><i class="fa ${enLista ? 'fa-heart' : 'fa-heart-o'}"></i></div><a href="/producto.html?id=${producto.id}"><img src="${producto.imagen_url || '/assets/images/no-image.jpg'}" class="product-image" alt="${producto.nombre}"><h3 class="product-title">${producto.nombre}</h3></a>${renderizarPrecioConDescuento(producto)}<button class="btn-add-cart" onclick="window.carrito.agregar('${producto.id}', 1)"><i class="fa fa-shopping-cart"></i> Agregar</button></div>`
                }
            }).join('')
        }

        async function inicializar() {
            await cargarListaDeseos();
            actualizarBotonLogin();
            await Promise.all([cargarSlider(), cargarDestacados(), cargarOfertas(), cargarConsumibles(), cargarLimpieza(), cargarUltimos()]);
            setTimeout(async () => { await renderizarListaNotificaciones(); await actualizarBadgeCampana(); }, 1000);
        }

        inicializar();

        auth.onCambio(async (usuario) => {
            actualizarBotonLogin();
            await cargarListaDeseos();
            await Promise.all([cargarSlider(), cargarDestacados(), cargarOfertas(), cargarConsumibles(), cargarLimpieza(), cargarUltimos()]);
            setTimeout(async () => { await renderizarListaNotificaciones(); await actualizarBadgeCampana(); }, 1000);
        });

        window.addEventListener('scroll', function() {
            const backTop = document.querySelector('.back-top')
            backTop.style.display = window.scrollY > 300 ? 'flex' : 'none'
        })
        document.querySelector('.back-top')?.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }) })
    </script>

    <script type="module">
        import { cryptoManager } from '/js/crypto.js'
        window.cryptoManager = cryptoManager
    </script>
    
    <div id="avisoDisponibilidad">
        <div>
            <div style="font-size: 48px; margin-bottom: 15px;">🏪</div>
            <h2>Información importante</h2>
            <p>Los productos mostrados en esta página <strong>solo están disponibles en tienda física en <span class="highlight">Sagua de Tánamo</span></strong> y domicilio <strong>exclusivo para Sagua de Tánamo</strong>.</p>
            <p>Si deseas ver productos de <strong>toda Cuba</strong>, haz clic en el botón <strong style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; padding: 4px 12px; border-radius: 30px; font-size: 13px;">🇨🇺 KOMERZIO 🇨🇺</strong> en el menú superior.</p>
            <div style="display: flex; align-items: center; justify-content: center; gap: 15px; margin: 25px 0 20px;">
                <input type="checkbox" id="noMostrarMas" style="width: 18px; height: 18px; cursor: pointer; accent-color: var(--accent);">
                <label for="noMostrarMas" style="color: var(--text-light); cursor: pointer; font-size: 14px;">No mostrar más este mensaje</label>
            </div>
            <button id="btnAceptarAviso" class="btn-aviso">Entendido</button>
        </div>
    </div>

    <script>
        (function() {
            const noMostrar = localStorage.getItem('komerzio_no_mostrar_aviso');
            if (noMostrar === 'true') { document.getElementById('avisoDisponibilidad').style.display = 'none'; return; }
            const btnAceptar = document.getElementById('btnAceptarAviso');
            const checkbox = document.getElementById('noMostrarMas');
            const aviso = document.getElementById('avisoDisponibilidad');
            btnAceptar.addEventListener('click', function() {
                if (checkbox.checked) localStorage.setItem('komerzio_no_mostrar_aviso', 'true');
                aviso.style.display = 'none';
            });
            aviso.addEventListener('click', function(e) {
                if (e.target === aviso) {
                    if (checkbox.checked) localStorage.setItem('komerzio_no_mostrar_aviso', 'true');
                    aviso.style.display = 'none';
                }
            });
        })();
    </script>
    <script type="module">
        import { popupsManager } from '/js/popups.js';
        window.popupsManager = popupsManager;
        setTimeout(() => { if (typeof auth !== 'undefined' && auth.isAuthenticated() && popupsManager && typeof popupsManager.verificarYMostrarPopup === 'function') { popupsManager.verificarYMostrarPopup(); } }, 3000);
    </script>
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "01f3e8e7839b4bb898a88a0a97df82b6"}'></script>
</body>
</html>