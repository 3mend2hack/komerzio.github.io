<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes, viewport-fit=cover">
    
    <!-- ===== META TAGS OPTIMIZADOS PARA SEO ===== -->
    <title>KOMERZIO · Marketplace Cubano | Compra y Vende en Toda Cuba</title>
    <meta name="description" content="KOMERZIO es el marketplace líder en Cuba. Compra productos de electrónica, ropa, hogar y más. Vendedores verificados. Pago contra entrega. Envíos a toda Cuba.">
    <meta name="keywords" content="KOMERZIO, marketplace Cuba, comprar en Cuba, tienda online Cuba, productos Cuba, electrónica Cuba, ropa Cuba, vendedores Cuba, Sagua de Tánamo, Holguín">
    <meta name="author" content="KOMERZIO">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="language" content="Spanish">
    <meta name="revisit-after" content="3 days">
    <meta name="geo.region" content="CU-HO">
    <meta name="geo.placename" content="Sagua de Tánamo, Holguín">
    <meta name="geo.position" content="20.5833;-75.7333">
    <meta name="ICBM" content="20.5833, -75.7333">
    
    <!-- ===== OPEN GRAPH / FACEBOOK / WHATSAPP ===== -->
    <meta property="og:title" content="KOMERZIO · Marketplace Cubano | Compra y Vende en Toda Cuba">
    <meta property="og:description" content="Compra productos en Sagua de Tánamo y toda Cuba. Ropa, electrónica, hogar y más. Vendedores locales verificados. Pago contra entrega.">
    <meta property="og:image" content="https://komerzio.dpdns.org/assets/images/komerzio.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="KOMERZIO - Marketplace Cubano">
    <meta property="og:url" content="https://komerzio.dpdns.org">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="KOMERZIO">
    <meta property="og:locale" content="es_ES">
    
    <!-- ===== TWITTER CARDS ===== -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="KOMERZIO · Marketplace Cubano">
    <meta name="twitter:description" content="Compra productos en Sagua de Tánamo y toda Cuba. Ropa, electrónica, hogar y más. Vendedores locales verificados.">
    <meta name="twitter:image" content="https://komerzio.dpdns.org/assets/images/komerzio.png">
    <meta name="twitter:site" content="@komerzio">
    <meta name="twitter:creator" content="@komerzio">
    
    <!-- ===== CANONICAL URL ===== -->
    <link rel="canonical" href="https://komerzio.dpdns.org">
    
    <!-- ===== ALTERNATE PARA MÓVILES ===== -->
    <link rel="alternate" media="only screen and (max-width: 640px)" href="https://komerzio.dpdns.org">
    
    <!-- ===== SCHEMA.ORG - DATOS ESTRUCTURADOS ===== -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "KOMERZIO",
        "alternateName": ["KOMERZIO Marketplace", "KOMERZIO Cuba"],
        "url": "https://komerzio.dpdns.org",
        "description": "Marketplace cubano para comprar y vender productos. Electrónica, ropa, hogar y más. Vendedores verificados. Pago contra entrega.",
        "inLanguage": "es",
        "potentialAction": {
            "@type": "SearchAction",
            "target": {
                "@type": "EntryPoint",
                "urlTemplate": "https://komerzio.dpdns.org/buscar.html?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
        },
        "publisher": {
            "@type": "Organization",
            "name": "KOMERZIO",
            "url": "https://komerzio.dpdns.org",
            "logo": {
                "@type": "ImageObject",
                "url": "https://komerzio.dpdns.org/assets/images/komerzio.png",
                "width": 512,
                "height": 512
            },
            "sameAs": [
                "https://www.facebook.com/komerzio",
                "https://www.instagram.com/komerzio"
            ],
            "contactPoint": {
                "@type": "ContactPoint",
                "telephone": "+5356591892",
                "contactType": "customer service",
                "availableLanguage": "Spanish",
                "areaServed": "CU"
            }
        }
    }
    </script>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    
    <!-- Owl Carousel -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">
    
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --primary: #0f172a;
            --primary-light: #1e293b;
            --accent: #f97316;
            --accent-light: #fb923c;
            --accent-dark: #ea580c;
            --gold: #fbbf24;
            --gold-dark: #f59e0b;
            --blue: #3b82f6;
            --blue-dark: #2563eb;
            --price: #dc2626;
            --text: #0f172a;
            --text-light: #475569;
            --border: #e2e8f0;
            --card: #ffffff;
            --success: #16a34a;
            --danger: #dc2626;
            --warning: #d97706;
            --bg: #f1f5f9;
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
            --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
            --shadow-lg: 0 10px 30px rgba(0,0,0,0.12);
            --shadow-xl: 0 20px 40px rgba(0,0,0,0.15);
            --radius: 16px;
            --radius-sm: 10px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        html, body {
            overflow-x: hidden !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            background: var(--bg);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        a { text-decoration: none; color: inherit; }
        #outer-wrapper { overflow-x: hidden !important; width: 100% !important; }

        /* ===== HEADER ===== */
        #header-wrap {
            background: var(--primary);
            color: white;
            position: sticky;
            top: 0;
            z-index: 100;
            width: 100%;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }
        .header-header { padding: 12px 20px; width: 100%; }
        .container.row { max-width: 1500px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; width: 100%; flex-wrap: wrap; gap: 12px; }
        
        .header-logo { display: flex; align-items: center; }
        .logo-text {
            background: linear-gradient(135deg, #f97316 0%, #fbbf24 100%);
            background-clip: text; -webkit-background-clip: text;
            color: transparent; font-size: 28px; font-weight: 800;
            letter-spacing: -0.5px; text-shadow: 0 2px 20px rgba(249,115,22,0.2);
            transition: var(--transition);
        }
        .logo-text:hover { transform: scale(1.02); }
        @media (max-width: 768px) { .logo-text { font-size: 22px; } }
        
        .header-right { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
        
        .saldo-mini-card {
            background: linear-gradient(135deg, #059669 0%, #10b981 100%);
            color: white; padding: 6px 14px; border-radius: 30px;
            display: flex; align-items: center; gap: 8px; font-size: 13px;
            font-weight: 700; white-space: nowrap;
            border: 1px solid rgba(255,255,255,0.15);
            box-shadow: 0 2px 12px rgba(16,185,129,0.3);
            transition: var(--transition);
        }
        .saldo-mini-card:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(16,185,129,0.4); }
        .saldo-mini-card i { font-size: 14px; }
        
        .btn-recarga-mini {
            background: rgba(255,255,255,0.15); border: none; color: white;
            width: 26px; height: 26px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; margin-left: 4px; transition: var(--transition); font-size: 12px;
        }
        .btn-recarga-mini:hover { background: var(--accent); transform: scale(1.1); }
        
        .campana-icono {
            width: 40px; height: 40px; background: rgba(255,255,255,0.08);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: var(--transition); position: relative;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .campana-icono:hover { background: var(--accent); transform: translateY(-2px); border-color: var(--accent); }
        .campana-icono i { color: white; font-size: 18px; }
        .campana-badge {
            position: absolute; top: -4px; right: -4px;
            background: #ef4444; color: white; font-size: 10px; font-weight: 700;
            min-width: 18px; height: 18px; border-radius: 9px;
            display: flex; align-items: center; justify-content: center; padding: 0 5px;
            box-shadow: 0 2px 8px rgba(239,68,68,0.4);
        }
        .campana-panel {
            position: absolute; top: 48px; right: 0; width: 340px;
            background: white; border-radius: var(--radius);
            box-shadow: var(--shadow-xl); z-index: 1000; overflow: hidden;
            border: 1px solid var(--border);
        }
        @media (max-width: 480px) { .campana-panel { width: 300px; right: -60px; } }
        
        .login-btn {
            color: white; text-decoration: none; font-size: 13px; font-weight: 500;
            display: flex; align-items: center; gap: 6px; padding: 8px 16px;
            background: rgba(255,255,255,0.08); border-radius: 30px;
            transition: var(--transition); white-space: nowrap;
            border: 1px solid rgba(255,255,255,0.08);
        }
        .login-btn:hover { background: var(--accent); border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 4px 15px rgba(249,115,22,0.3); }
        @media (max-width: 768px) { .login-btn span { display: none; } .login-btn { padding: 8px 10px; border-radius: 50%; } }
        
        .sora-cart { position: relative; }
        .sora-cart-details {
            width: 40px; height: 40px; background: rgba(255,255,255,0.08);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: var(--transition);
            border: 1px solid rgba(255,255,255,0.05);
            position: relative;
        }
        .sora-cart-details:hover { background: var(--accent); transform: translateY(-2px); border-color: var(--accent); }
        .sora-cart-details:after { content: '\f290'; font-family: 'FontAwesome'; font-size: 18px; color: white; }
        .simpleCart_quantity {
            background: var(--accent); color: white; font-weight: 700;
            padding: 2px 6px; border-radius: 20px; font-size: 10px;
            position: absolute; top: -4px; right: -4px; min-width: 18px; text-align: center;
            box-shadow: 0 2px 8px rgba(249,115,22,0.4);
        }
        .sora-cart-description {
            position: absolute; right: 0; top: 50px; width: 360px;
            background: white; border-radius: var(--radius);
            box-shadow: var(--shadow-xl); padding: 16px; display: none; z-index: 1000;
            border: 1px solid var(--border);
        }
        @media (max-width: 480px) { .sora-cart-description { width: 310px; right: -60px; } }
        .sora-cart:hover .sora-cart-description { display: block; }

        /* ===== MENU ===== */
        .header-menu {
            background: var(--primary-light); padding: 0 20px; overflow-x: auto;
            -webkit-overflow-scrolling: touch; scrollbar-width: none;
            border-top: 1px solid rgba(255,255,255,0.06);
        }
        .header-menu::-webkit-scrollbar { display: none; }
        #main-menu ul { display: flex; list-style: none; gap: 8px; padding: 8px 0; margin: 0; white-space: nowrap; }
        #main-menu ul li a {
            color: #94a3b8; font-size: 13px; font-weight: 500; padding: 6px 12px; 
            display: block; transition: var(--transition); text-decoration: none;
            border-radius: 8px;
        }
        #main-menu ul li a:hover { color: white; background: rgba(255,255,255,0.06); }
        #main-menu ul li a i { margin-right: 4px; }
        
        .btn-crypto {
            background: linear-gradient(135deg, var(--accent), var(--gold-dark)) !important;
            color: white !important; padding: 4px 14px !important; border-radius: 30px !important;
            display: flex; align-items: center; gap: 5px; font-weight: 600 !important;
        }
        .btn-crypto:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(249,115,22,0.3) !important; background: rgba(255,255,255,0.1) !important; }
        
        .btn-tcp {
            background: linear-gradient(135deg, var(--blue), var(--blue-dark)) !important;
            color: white !important; padding: 4px 14px !important; border-radius: 30px !important;
            font-weight: 600 !important; font-size: 12px !important;
            display: flex; align-items: center; gap: 5px;
        }
        .btn-tcp:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(59,130,246,0.3) !important; }

        /* ===== SLIDER ===== */
        .slider-outer-wrap { max-width: 1500px; margin: 24px auto; padding: 0 20px; width: 100%; }
        .main-slider { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-md); }
        .slider-item { position: relative; height: 420px; background: var(--primary); }
        .slider-item img { width: 100%; height: 100%; object-fit: cover; }
        .slider-item .post-info-wrap {
            position: absolute; bottom: 0; left: 0; right: 0;
            padding: 50px 40px 30px;
            background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 100%);
            color: white;
        }
        .slider-item .post-title { font-size: 30px; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.5px; }
        .slider-item .post-title a { color: white; transition: var(--transition); }
        .slider-item .post-title a:hover { color: var(--accent); }
        .slider-item .post-tag {
            background: var(--accent); padding: 4px 14px; border-radius: 30px;
            font-size: 11px; font-weight: 600; display: inline-block; margin-bottom: 10px;
            letter-spacing: 0.5px; text-transform: uppercase;
        }
        @media (max-width: 768px) { .slider-item { height: 260px; } .slider-item .post-title { font-size: 18px; } .slider-item .post-info-wrap { padding: 30px 20px 20px; } }
        .owl-theme .owl-dots .owl-dot span { background: rgba(255,255,255,0.3) !important; }
        .owl-theme .owl-dots .owl-dot.active span { background: var(--accent) !important; }

        /* ===== HOT SECTION ===== */
        .hot-section {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4c1d95 100%);
            padding: 48px 20px; margin: 40px 0; color: white; width: 100%;
            position: relative;
            overflow: hidden;
        }
        .hot-section::before {
            content: '';
            position: absolute; top: -50%; right: -20%; width: 300px; height: 300px;
            background: rgba(249,115,22,0.1); border-radius: 50%;
        }
        .hot-header { max-width: 1500px; margin: 0 auto 30px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; position: relative; z-index: 1; }
        .hot-header h2 { font-size: 28px; font-weight: 800; }
        .hot-header a { color: var(--gold); font-weight: 600; transition: var(--transition); }
        .hot-header a:hover { color: white; transform: translateX(4px); }

        /* ===== PRODUCT GRIDS ===== */
        .products-grid: ;, #featured-products, #latest-products {
            display: grid !important; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)) !important;
            gap: 24px !important; max-width: 1500px !important; margin: 0 auto !important;
            padding: 0 20px !important; width: 100% !important;
        }
        .hot-posts, #hot-posts-container {
            display: grid !important; grid-template-columns: repeat(4, 1fr) !important;
            gap: 24px !important; max-width: 1500px !important; margin: 0 auto !important;
            padding: 0 20px !important; width: 100% !important;
        }
        @media (max-width: 1024px) { .hot-posts, #hot-posts-container { grid-template-columns: repeat(2, 1fr) !important; } }
        @media (max-width: 768px) {
            .products-grid, #featured-products, #latest-products { grid-template-columns: repeat(2, 1fr) !important; gap: 16px !important; padding: 0 16px !important; }
            .hot-posts, #hot-posts-container { padding: 0 16px !important; gap: 16px !important; }
        }
        @media (max-width: 480px) { .products-grid, #featured-products, #latest-products { grid-template-columns: 1fr !important; } .hot-posts, #hot-posts-container { grid-template-columns: 1fr !important; } }

        /* ===== PRODUCT CARD ===== */
        .product-card {
            background: var(--card); border-radius: var(--radius); padding: 18px;
            box-shadow: var(--shadow-sm); transition: var(--transition);
            display: flex; flex-direction: column; position: relative;
            border: 1px solid var(--border);
        }
        .product-card:hover {
            transform: translateY(-6px); box-shadow: var(--shadow-lg);
            border-color: var(--accent);
        }
        .product-badge {
            position: absolute; top: 12px; left: 12px;
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            color: white; padding: 4px 12px; border-radius: 30px; font-size: 10px;
            font-weight: 700; z-index: 5; display: flex; align-items: center; gap: 4px;
            text-transform: uppercase; letter-spacing: 0.5px;
        }
        .product-image {
            width: 100%; aspect-ratio: 1/1; object-fit: contain; margin-bottom: 12px;
            background: #f8fafc; border-radius: var(--radius-sm); cursor: pointer;
            transition: var(--transition); padding: 8px;
        }
        .product-image:hover { transform: scale(1.03); }
        .product-title {
            font-size: 15px; font-weight: 600; margin-bottom: 6px; line-height: 1.4;
            height: 42px; overflow: hidden; display: -webkit-box;
            -webkit-line-clamp: 2; -webkit-box-orient: vertical;
            color: var(--text); transition: var(--transition);
        }
        .product-title:hover { color: var(--accent); }
        .product-price { font-size: 22px; font-weight: 700; color: var(--price); margin: 6px 0; display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
        .product-price small { font-size: 13px; font-weight: 400; color: var(--text-light); }
        .product-original-price { font-size: 13px; color: var(--text-light); text-decoration: line-through; margin-left: 6px; }
        .product-discount {
            display: inline-block; background: var(--danger); color: white;
            padding: 2px 8px; border-radius: 20px; font-size: 10px; font-weight: 700;
            margin-left: 6px;
        }
        .product-stock { font-size: 12px; margin: 6px 0; padding: 4px 12px; border-radius: 30px; display: inline-flex; align-items: center; gap: 6px; width: fit-content; }
        .stock-available { background: #dcfce7; color: var(--success); }
        .product-agotado {
            background: var(--danger); color: white; padding: 10px;
            border-radius: 40px; font-size: 13px; font-weight: 600; text-align: center; margin-top: 10px;
        }
        .btn-add-cart {
            background: linear-gradient(135deg, var(--gold), var(--gold-dark));
            border: none; border-radius: 40px; padding: 12px;
            font-size: 14px; font-weight: 600; color: var(--primary);
            cursor: pointer; transition: var(--transition);
            margin-top: auto; display: flex; align-items: center; justify-content: center;
            gap: 8px; width: 100%;
        }
        .btn-add-cart:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(251,191,36,0.4); }

        /* ===== CATEGORIAS ===== */
        .categorias-grid {
            display: grid !important; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)) !important;
            gap: 20px !important; max-width: 1500px !important; margin: 0 auto 40px !important;
            padding: 0 20px !important; width: 100% !important;
        }
        .categoria-card {
            background: white; padding: 28px 20px; border-radius: var(--radius); text-align: center;
            box-shadow: var(--shadow-sm); transition: var(--transition);
            border: 1px solid var(--border); text-decoration: none; display: block;
        }
        .categoria-card:hover { transform: translateY(-6px); border-color: var(--accent); box-shadow: var(--shadow-md); }
        .categoria-card i { font-size: 40px; color: var(--primary); margin-bottom: 12px; }
        .categoria-card h3 { font-size: 18px; color: var(--text); margin-bottom: 4px; font-weight: 600; }
        .categoria-card p { color: var(--text-light); font-size: 13px; }
        .categoria-card.ofertas {
            background: linear-gradient(135deg, #1e1b4b 0%, #4c1d95 100%);
            border-color: transparent;
        }
        .categoria-card.ofertas i, .categoria-card.ofertas h3, .categoria-card.ofertas p { color: white; }
        .categoria-card.ofertas:hover { transform: translateY(-6px); box-shadow: 0 8px 25px rgba(76,29,149,0.3); }

        /* ===== CARRUSEL ===== */
        .carrusel-container { margin: 30px 0 50px; position: relative; max-width: 1500px; margin-left: auto; margin-right: auto; padding: 0 20px; }
        .carrusel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; }
        .carrusel-header h2 { font-size: 24px; font-weight: 700; display: flex; align-items: center; gap: 10px; }
        .carrusel-nav { display: flex; gap: 10px; }
        .carrusel-nav-btn {
            width: 40px; height: 40px; background: white; border: 2px solid var(--border);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: var(--transition); font-size: 16px;
        }
        .carrusel-nav-btn:hover { background: var(--accent); border-color: var(--accent); color: white; transform: scale(1.05); }
        .carrusel-items {
            display: flex; gap: 20px; overflow-x: auto; scroll-behavior: smooth;
            padding: 10px 5px 20px; scrollbar-width: thin;
            scrollbar-color: var(--accent) var(--border);
        }
        .carrusel-items::-webkit-scrollbar { height: 4px; }
        .carrusel-items::-webkit-scrollbar-track { background: var(--border); border-radius: 10px; }
        .carrusel-items::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 10px; }
        .carrusel-item {
            min-width: 260px; max-width: 260px; background: var(--card);
            border-radius: var(--radius); padding: 16px; box-shadow: var(--shadow-sm);
            transition: var(--transition); border: 1px solid var(--border); position: relative;
            flex-shrink: 0;
        }
        .carrusel-item:hover { transform: translateY(-6px); border-color: var(--accent); box-shadow: var(--shadow-md); }
        .carrusel-item .wishlist-btn {
            position: absolute; top: 12px; right: 12px; width: 32px; height: 32px;
            background: white; border-radius: 50%; display: flex; align-items: center;
            justify-content: center; cursor: pointer; z-index: 5;
            box-shadow: var(--shadow-sm); border: 1px solid var(--border);
            transition: var(--transition);
        }
        .carrusel-item .wishlist-btn:hover { transform: scale(1.1); }
        .carrusel-item .product-image { width: 100%; aspect-ratio: 1/1; object-fit: contain; margin-bottom: 12px; background: #f8fafc; border-radius: var(--radius-sm); padding: 8px; }
        .carrusel-item .product-title { font-size: 14px; height: 40px; }
        .btn-add-cart-small {
            background: linear-gradient(135deg, var(--gold), var(--gold-dark));
            border: none; border-radius: 30px; padding: 10px;
            font-size: 12px; font-weight: 600; cursor: pointer;
            width: 100%; display: flex; align-items: center;
            justify-content: center; gap: 6px; margin-top: 10px;
            transition: var(--transition);
        }
        .btn-add-cart-small:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(251,191,36,0.3); }
        .carrusel-progress { display: flex; gap: 8px; margin-top: 20px; justify-content: center; }
        .carrusel-progress-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--border); transition: var(--transition); cursor: pointer; }
        .carrusel-progress-dot.active { background: var(--accent); transform: scale(1.3); }

        /* ===== SECTION TITLE ===== */
        .section-title {
            max-width: 1500px; margin: 40px auto 20px; padding: 0 20px;
            font-size: 26px; font-weight: 700; display: flex; align-items: center;
            gap: 10px; color: var(--text);
        }
        .btn-ver-mas {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            color: white; padding: 8px 20px; border-radius: 40px;
            text-decoration: none; font-weight: 600; display: inline-flex;
            align-items: center; gap: 8px; font-size: 14px;
            transition: var(--transition);
        }
        .btn-ver-mas:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(139,92,246,0.3); }

        /* ===== FOOTER ===== */
        #footer-wrapper { background: var(--primary); color: white; padding: 48px 20px; margin-top: 50px; width: 100%; }
        .footer-widgets-wrap { max-width: 1500px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; width: 100%; }
        @media (max-width: 768px) { .footer-widgets-wrap { grid-template-columns: 1fr; text-align: center; gap: 30px; } }
        .footer h3 { color: white; margin-bottom: 20px; font-weight: 700; }
        .footer a { color: #94a3b8; text-decoration: none; transition: var(--transition); }
        .footer a:hover { color: var(--accent); }
        .footer ul { list-style: none; }
        .footer ul li { margin-bottom: 8px; }
        #sub-footer-wrapper { background: var(--primary-light); padding: 16px; text-align: center; color: #94a3b8; font-size: 13px; border-top: 1px solid rgba(255,255,255,0.05); }

        /* ===== BACK TO TOP ===== */
        .back-top {
            position: fixed; bottom: 24px; right: 24px;
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            color: white; width: 46px; height: 46px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; display: none; transition: var(--transition);
            z-index: 99; border: none; box-shadow: 0 4px 15px rgba(249,115,22,0.4);
        }
        .back-top:hover { transform: translateY(-4px); box-shadow: 0 6px 25px rgba(249,115,22,0.5); }

        /* ===== WISHLIST BUTTON ===== */
        .wishlist-btn {
            position: absolute; top: 12px; right: 12px; width: 34px; height: 34px;
            background: white; border-radius: 50%; display: flex; align-items: center;
            justify-content: center; cursor: pointer; z-index: 5;
            box-shadow: var(--shadow-sm); border: 1px solid var(--border);
            transition: var(--transition);
        }
        .wishlist-btn:hover { transform: scale(1.1); }
        .wishlist-btn.active { background: var(--danger); border-color: var(--danger); }
        .wishlist-btn.active i { color: white; }

        /* ===== NOTIFICACIONES PANEL ===== */
        .campana-header { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; background: #f8fafc; border-bottom: 1px solid var(--border); font-weight: 600; }
        .campana-header span { color: var(--text) !important; }
        .campana-marcar { background: none; border: none; color: var(--accent) !important; font-size: 12px; cursor: pointer; font-weight: 600; transition: var(--transition); }
        .campana-marcar:hover { color: var(--accent-dark) !important; }
        .campana-lista { max-height: 350px; overflow-y: auto; }
        .campana-item { padding: 14px 18px; border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: var(--transition); }
        .campana-item:hover { background: #f8fafc; }
        .campana-item.no-leida { background: #fffbeb; border-left: 3px solid var(--accent); }
        .campana-item.no-leida:hover { background: #fef3c7; }
        .campana-item-titulo { font-weight: 600; font-size: 14px; margin-bottom: 4px; color: var(--text) !important; }
        .campana-item-mensaje { font-size: 13px; color: var(--text-light) !important; margin-bottom: 4px; }
        .campana-item-fecha { font-size: 11px; color: #94a3b8 !important; }
        .campana-vacio { text-align: center; padding: 40px 20px; color: #94a3b8 !important; }
        .campana-footer { padding: 12px; text-align: center; border-top: 1px solid var(--border); }
        .campana-footer a { color: var(--accent) !important; text-decoration: none; font-size: 13px; font-weight: 500; }

        /* ===== CART PREVIEW ===== */
        .cart-preview-footer { margin-top: 15px; padding-top: 12px; border-top: 1px solid var(--border); }
        .cart-preview-total { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-weight: 600; font-size: 14px; }
        .cart-preview-total span:last-child { color: var(--price); font-size: 16px; }
        .cart-preview-buttons { display: flex; gap: 10px; flex-wrap: wrap; }
        .cart-preview-btn {
            flex: 1; padding: 10px 12px; border-radius: 30px; font-size: 12px; font-weight: 600;
            text-align: center; text-decoration: none; cursor: pointer;
            transition: var(--transition); border: none;
        }
        .cart-preview-btn-primary { background: var(--accent); color: white; }
        .cart-preview-btn-primary:hover { background: var(--accent-dark); transform: translateY(-2px); }
        .cart-preview-btn-secondary { background: #f1f5f9; color: var(--text); }
        .cart-preview-btn-secondary:hover { background: #e2e8f0; }
        .simpleCart_items { max-height: 300px; overflow-y: auto; }
        .cart-item { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }
        .cart-item-image { width: 56px; height: 56px; object-fit: contain; background: #f8fafc; border-radius: 8px; padding: 4px; }
        .cart-item-info { flex: 1; }
        .cart-item-title { font-weight: 600; font-size: 13px; margin-bottom: 4px; color: var(--text); }
        .cart-item-price { font-size: 12px; color: var(--price); font-weight: 700; }
        .cart-item-quantity { display: flex; align-items: center; gap: 8px; margin-top: 6px; }
        .cart-item-quantity button {
            width: 24px; height: 24px; border-radius: 4px; border: 1px solid var(--border);
            background: white; cursor: pointer; font-size: 14px; transition: var(--transition);
        }
        .cart-item-quantity button:hover { background: var(--accent); color: white; border-color: var(--accent); }
        .cart-item-quantity span { font-size: 13px; min-width: 30px; text-align: center; color: var(--text) !important; font-weight: 600; }
        .cart-item-subtotal { font-weight: 700; font-size: 13px; color: var(--price); min-width: 70px; text-align: right; }

        /* ===== AVISO ===== */
        #avisoDisponibilidad { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15,23,42,0.8); z-index: 9999; display: flex; align-items: center; justify-content: center; font-family: 'Inter', sans-serif; backdrop-filter: blur(4px); }
        #avisoDisponibilidad > div {
            background: white; max-width: 500px; width: 90%; border-radius: var(--radius);
            padding: 30px; text-align: center; box-shadow: var(--shadow-xl);
            animation: modalIn 0.3s ease;
        }
        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.95) translateY(10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
        #avisoDisponibilidad h2 { color: var(--text); margin-bottom: 15px; }
        #avisoDisponibilidad p { color: var(--text-light); margin-bottom: 20px; line-height: 1.6; }
        #avisoDisponibilidad strong { color: var(--text); }
        #avisoDisponibilidad .highlight { color: var(--accent); font-weight: 700; }
        #avisoDisponibilidad .btn-aviso {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            color: white; border: none; padding: 12px 30px; border-radius: 40px;
            font-size: 16px; font-weight: 600; cursor: pointer;
            width: 100%; transition: var(--transition);
        }
        #avisoDisponibilidad .btn-aviso:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(249,115,22,0.3); }
    </style>
</head>
