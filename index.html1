        <div class="products-grid" id="featured-products"></div>

        <h2 class="section-title">📦 Categorías</h2>
        <div class="categorias-grid">
            <a href="/categoria.html?cat=Electrónica" class="categoria-card" title="Electrónica en KOMERZIO">
