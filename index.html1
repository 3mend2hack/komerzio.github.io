                            <li><a href="/buscar.html"><i class="fa fa-search"></i> Buscar</a></li>
                            <li><a href="/lista-deseos.html"><i class="fa fa-heart"></i> Mi Lista</a></li>
                            <li><a href="/recarga.html" class="btn-crypto"><i class="fa fa-bolt"></i> Recargar</a></li>
                            <li><a href="/index.html" class="btn-tcp"><i class="fa fa-globe"></i> 🇨🇺 KOMERZIO🇨🇺</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="slider-outer-wrap">
            <div class="main-slider owl-carousel" id="home-slider"></div>
        </div>

        <div class="hot-section">
            <div class="hot-header">
                <h2>🔥 Ofertas del Día</h2>
                <a href="/categoria.html?cat=ofertas">Ver todas →</a>
            </div>
            <div class="hot-posts" id="hot-posts-container"></div>
        </div>

        <div style="max-width: 1500px; margin: 0 auto 20px; padding: 0 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
            <h2 class="section-title" style="margin-bottom: 0;">✨ Productos Destacados</h2>
